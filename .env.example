# Client: trust-on-client offline scoring (demo / air-gapped solo only).
# Competitive daily mode should leave this unset and run the Node API server.
VITE_OFFLINE=false

# Production static+API server port (npm run start)
PORT=4173

# Required for server-mode sessions (HMAC signing). Generate with: openssl rand -base64 32
AAD_SESSION_SECRET=

# No third-party API keys required for the demo (OSM tiles are public; respect tile policy at scale).
